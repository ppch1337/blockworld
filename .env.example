NODE_ENV=development
PORT=3000
# Optional for local-only testing. For public hosting, set DATABASE_URL to your managed PostgreSQL URL.
DATABASE_URL=
# For local testing, replace this with a unique random secret. In Render, set this in Environment instead.
SESSION_SECRET=replace-this-with-a-long-unique-random-secret-value

# Account deletion request email via Resend HTTPS API (configure in Render Environment)
OWNER_EMAIL=your-owner-email@example.com
RESEND_API_KEY=re_your_resend_api_key
# For initial testing, Resend's onboarding sender can only send to your own Resend account email.
# For a verified domain, set e.g. BlockWorld <noreply@yourdomain.com>
RESEND_FROM=BlockWorld <onboarding@resend.dev>
